# fomo API integration
# Set the base URL of the fomo API you have access to.
FOMO_API_BASE_URL=https://api.fomo.family

# Your fomo API key / token. Kept server-side only (never exposed to the browser).
FOMO_API_KEY=

# Toggle data source:
#   mock = use built-in sample data (default, works with no API)
#   live = call the real fomo API using the vars above
NEXT_PUBLIC_FOMO_DATA_SOURCE=mock
