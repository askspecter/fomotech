# fomo API (https://fomoapi.io) integration
# Base URL of the fomo API.
FOMO_API_BASE_URL=https://api.fomoapi.io

# Your fomo API key (Bearer token). Create a free key at https://fomoapi.io.
# Kept server-side only — never exposed to the browser.
FOMO_API_KEY=

# Data source toggle:
#   mock = built-in sample data (default, works with no key, costs 0 credits)
#   live = call the real fomo API using the key above
NEXT_PUBLIC_FOMO_DATA_SOURCE=mock

# Live Feed polling interval (ms). /v2/alerts costs 0.5 credits per call,
# so keep this high on the free tier (1,000 credits/mo). 15s is about 120 credits/hr.
NEXT_PUBLIC_FEED_POLL_MS=15000

# Central cache (optional but recommended). Set EITHER Vercel KV or Upstash
# Redis vars and the app caches fomo/DexScreener/RPC results so all visitors
# share one lookup per short window (fast + far fewer credits). If unset, the
# app still works and fetches live every time.
#   Vercel KV:  KV_REST_API_URL, KV_REST_API_TOKEN
#   Upstash:    UPSTASH_REDIS_REST_URL, UPSTASH_REDIS_REST_TOKEN
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Real profile pictures on the leaderboard. The leaderboard endpoint does not
# include avatars, so each one is resolved via /v2/users/{handle} (10 credits
# each, cached 1h). This is the number of TOP traders to resolve real photos
# for; everyone else gets a generated identicon (0 credits). 0 = off (identicons
# only). Example: 10 top avatars = up to 100 credits per hour.
FOMO_AVATAR_RESOLVE_COUNT=0

# --- Launchpad: wallet + PONS v2 on Robinhood Chain ---
# WalletConnect Project ID (free at cloud.reown.com). Without it, MetaMask,
# browser and injected wallets still work; adding it enables the WalletConnect QR.
NEXT_PUBLIC_WC_PROJECT_ID=

# Chain / RPC / explorer (public, safe to expose). Defaults are Robinhood Chain.
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com

# Official $PEA token contract on Robinhood Chain. The dashboard reads its
# real-time price / market cap / holders from the explorer (client-side).
NEXT_PUBLIC_PEA_TOKEN=0xd046a0B73dBE5b4E00F507526C35E5426C873f99

# Live burn tracker. Burned $PEA is read on-chain as the balance held at these
# burn sinks (defaults to the dead + zero addresses). Override if you burn to a
# different address (comma-separated).
NEXT_PUBLIC_PEA_BURN_ADDRESSES=0x000000000000000000000000000000000000dEaD,0x0000000000000000000000000000000000000000
# Optional floor in whole $PEA (e.g. a known dev-supply burn) so the counter
# still shows a number if the on-chain read is unavailable. 0 = read-only.
NEXT_PUBLIC_PEA_BURN_MIN=0

# PONS v2 factory override (verified default is hardcoded in lib/pons/registry.ts).
NEXT_PUBLIC_PONS_V2_FACTORY=
# Optional extra ERC-20 quote assets for v2 (comma-separated addresses);
# validated on-chain before being offered.
NEXT_PUBLIC_V2_PAIR_TOKENS=
