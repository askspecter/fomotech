# fomo API (https://fomoapi.io) integration
# Base URL of the fomo API.
FOMO_API_BASE_URL=https://api.fomoapi.io

# Your fomo API key (Bearer token). Create a free key at https://fomoapi.io.
# Kept server-side only — never exposed to the browser.
FOMO_API_KEY=

# Data source toggle:
#   mock = built-in sample data (default, works with no key, costs 0 credits)
#   live = call the real fomo API using the key above
NEXT_PUBLIC_FOMO_DATA_SOURCE=mock

# Live Feed polling interval (ms). /v2/alerts costs 0.5 credits per call,
# so keep this high on the free tier (1,000 credits/mo). 15s is about 120 credits/hr.
NEXT_PUBLIC_FEED_POLL_MS=15000

# --- Launchpad: wallet + PONS v2 on Robinhood Chain ---
# WalletConnect Project ID (free at cloud.reown.com). Without it, MetaMask,
# browser and injected wallets still work; adding it enables the WalletConnect QR.
NEXT_PUBLIC_WC_PROJECT_ID=

# Chain / RPC / explorer (public, safe to expose). Defaults are Robinhood Chain.
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com

# PONS v2 factory override (verified default is hardcoded in lib/pons/registry.ts).
NEXT_PUBLIC_PONS_V2_FACTORY=
# Optional extra ERC-20 quote assets for v2 (comma-separated addresses);
# validated on-chain before being offered.
NEXT_PUBLIC_V2_PAIR_TOKENS=
